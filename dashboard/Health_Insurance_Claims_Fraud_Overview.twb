        <view>
          <datasources>
            <datasource caption='fraud_detection_output.csv (Multiple Connections)' name='federated.0uyuook09940a817g8f1b1uadix4' />
          </datasources>
          <datasource-dependencies datasource='federated.0uyuook09940a817g8f1b1uadix4'>
            <column caption='Loss Ratio' datatype='real' name='[Calculation_1832063233785869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([claim_amount]) * 1.10 / SUM([premium_amount])' />
