      <aliases enabled='yes' />
      <column caption='Total Claims -fd' datatype='integer' name='[Calculation_1832063178989574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([claim_id])' />
      </column>
      <column caption='Fraud claims' datatype='integer' name='[Calculation_1832063179165703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_flag])' />
      </column>
      <column caption='Fraud Rate-fd' datatype='real' default-format='p0.00%' name='[Calculation_1832063180660744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_flag])/ COUNT([claim_id])' />
      </column>
      <column caption='Fraud loss Amount' datatype='real' name='[Calculation_1832063224410121]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='SUM(IF [fraud_flag] = 1 THEN  [claim_amount] END)' />
      </column>
      <column caption='Avg Fraud Claim' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1832063227596810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if [fraud_flag]=1 then [claim_amount] END)' />
      </column>
      <column caption='Leakage Rate' datatype='real' name='[Calculation_1832063228846091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [fraud_flag] = 1&#13;&#10;AND [claim_status] = &quot;Approved&quot;&#13;&#10;THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([fraud_flag])' />
      </column>
      <column caption='Claim Ratio' datatype='real' name='[Calculation_1832063232802828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([claim_amount]) / SUM([premium_amount])' />
      </column>
      <column caption='Loss Ratio' datatype='real' name='[Calculation_1832063233785869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([claim_amount]) * 1.10 / SUM([premium_amount])' />
      </column>
      <column caption='Fraud Label' datatype='string' name='[Calculation_1832063237885966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fraud_flag] = 1 THEN &quot;Fraud&quot;&#13;&#10;ELSE &quot;Non-Fraud&quot;&#13;&#10;END' />
      </column>
      <column caption='Suspicious Hospital Flag' datatype='string' name='[Calculation_1832063240876048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fraud_rate] &gt; 0.30 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [fraud_rate] &gt; 0.10 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
