    <worksheet name='Avg Fraud Claim'>
      <table>
        <view>
          <datasources>
            <datasource caption='fraud_detection_output.csv (Multiple Connections)' name='federated.0uyuook09940a817g8f1b1uadix4' />
          </datasources>
          <datasource-dependencies datasource='federated.0uyuook09940a817g8f1b1uadix4'>
            <column caption='Avg Fraud Claim' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1832063227596810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [fraud_flag]=1 then [claim_amount] END)' />
            </column>
            <column caption='Claim Amount' datatype='real' name='[claim_amount]' role='measure' type='quantitative' />
